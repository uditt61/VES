NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Leave MONGODB_URI empty or set to mongodb://localhost:27017/vidhya_advance.
# If MongoDB is not running locally, backend seamlessly uses in-memory MongoDB in dev/test mode!
MONGODB_URI=

JWT_ACCESS_SECRET=vidhya_advance_super_secret_access_jwt_key_2026_education
JWT_REFRESH_SECRET=vidhya_advance_super_secret_refresh_jwt_key_2026_education
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ENQUIRY_RATE_LIMIT_MAX=20

# Email & SMTP Configuration (Nodemailer)
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
# For custom cPanel/Hostinger SMTP: Use mail.yourdomain.com port 465 (secure=true) or 587 (secure=false)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Vidhya Advance Education" <noreply@vidhyaadvance.com>
ADMIN_NOTIFICATION_EMAIL=i.o.sakshamm@gmail.com
